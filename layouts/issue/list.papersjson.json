{{- $articles := slice -}}
{{- range .RegularPages.ByWeight -}}
  {{- $articles = $articles | append (merge .Params.record (dict "url" .Permalink)) -}}
{{- end -}}
{{- $issue := dict "journal" site.Title "issue" .Title "articles" $articles -}}
{{- if .Params.example }}{{ $issue = merge $issue (dict "example" true) }}{{ end -}}
{{- $issue | jsonify -}}
