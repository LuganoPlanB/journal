{{/* Each issue uses its own HotCRP export, so paper IDs can repeat across issues. */}}
{{ range $index, $issue := hugo.Data.issues }}
  {{ $key := string $issue.key }}
  {{ $draft := $issue.draft | default false }}
  {{ $issuePage := dict "path" $key "kind" "section" "type" "issue" "title" $issue.title "weight" (add $index 1) "draft" $draft "outputs" (slice "html" "papersjson") }}
  {{ with $issue.date }}{{ $issuePage = merge $issuePage (dict "date" .) }}{{ end }}
  {{ $.AddPage $issuePage }}
  {{ range $order, $paper := index hugo.Data (printf "accepted-papers-%s" $key) }}
    {{ $record := partial "program/paper-record.html" (dict "year" $key "paper" $paper) }}
    {{ $pid := string $record.pid }}
    {{ with index (index hugo.Data (printf "proceedings-%s" $key) | default dict) $pid }}
      {{ $record = merge $record (dict "doi" .) }}
    {{ end }}
    {{ $params := dict "record" $record "issueKey" $key }}
    {{ $page := dict "path" (printf "%s/%s" $key $pid) "type" "article" "title" $paper.title "description" ($paper.abstract | default "") "params" $params "weight" (add $order 1) "draft" $draft }}
    {{ with $issue.date }}{{ $page = merge $page (dict "date" .) }}{{ end }}
    {{ $.AddPage $page }}
  {{ end }}
{{ end }}
